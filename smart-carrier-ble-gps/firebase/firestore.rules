rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid;
    }
    function isGuardian(ownerUid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(ownerUid)/guardians/$(request.auth.uid));
    }
    match /users/{ownerUid} {
      allow read, write: if isOwner(ownerUid);
      match /devices/{deviceId} {
        allow read, write: if isOwner(ownerUid);
      }
      match /requests/{guardianUid} {
        allow create: if signedIn() && request.auth.uid == guardianUid
          && request.resource.data.keys().hasOnly(['requestedAt']);
        allow read: if isOwner(ownerUid) || (signedIn() && request.auth.uid == guardianUid);
        allow delete: if isOwner(ownerUid) || (signedIn() && request.auth.uid == guardianUid);
        allow update: if false;
      }
      match /guardians/{guardianUid} {
        allow read: if isOwner(ownerUid) || (signedIn() && request.auth.uid == guardianUid);
        allow create, update, delete: if isOwner(ownerUid);
      }
      match /locations/{locationId} {
        allow read: if isOwner(ownerUid) || isGuardian(ownerUid);
        allow create, update, delete: if isOwner(ownerUid);
      }
      match /alerts/{alertId} {
        allow read: if isOwner(ownerUid) || isGuardian(ownerUid);
        allow create: if isOwner(ownerUid)
          && request.resource.data.keys().hasOnly([
            'type', 'message', 'latitude', 'longitude', 'createdAt'])
          && request.resource.data.type in ['sos', 'disconnect', 'safezone']
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 500;
        allow update, delete: if false;
      }
    }
  }
}
